{
  "name": "before-you-order-mobile",
  "version": "1.11.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.21",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-localization": "~57.0.1",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "react-test-renderer": "^19.2.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "validate:catalog": "tsx scripts/validate_catalog.ts",
    "validate": "npm run typecheck && npm test && npx expo export --platform android --output-dir dist-android"
  },
  "private": true
}
